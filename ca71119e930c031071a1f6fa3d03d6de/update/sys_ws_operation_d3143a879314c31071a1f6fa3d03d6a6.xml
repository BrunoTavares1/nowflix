        <name>Create/Update Media</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

	var media_array = request.body.data;
	
	if (JSON.stringify(media_array) == "{}") {
		response.setStatus(400);
		return "Não foi recebida nenhuma media.";
	}
		if (media_array.length == 0) {
		response.setStatus(400);
		return "Não foi recebida nenhuma media.";
	}

	try {
		var inputs = {};
		inputs['media_array'] = JSON.stringify(media_array); // Array.Object 
				
		var result = sn_fd.FlowAPI.getRunner().subflow('x_1845605_nowflix.media_inbound').inForeground().withInputs(inputs).run();
		var outputs = result.getOutputs();

		return outputs;
		
	} catch (ex) {
		var message = ex.getMessage();
		gs.error(message);
	}

})(request, response);]]></operation_script>
